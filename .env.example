# outbound-gtm-sc environment
# 1. Copy this file:   cp .env.example .env
# 2. Fill in YOUR OWN keys. Never commit .env (it is in .gitignore).
# 3. You only need the keys for the skills you run.

# --- 01 infra setup ---------------------------------------------------------
# Porkbun: https://porkbun.com/account/api (also enable API access on each domain)
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
# Zapmail: Zapmail app -> Settings -> API
ZAPMAIL_API_KEY=
# Optional, only if you use more than one Zapmail workspace
ZAPMAIL_WORKSPACE_KEY=

# --- 01, 09, 10, 11 PlusVibe -------------------------------------------------
# https://app.plusvibe.ai/v2/settings/api-access (Business plan). Workspace ID is on the same page.
PLUSVIBE_API_KEY=
PLUSVIBE_WORKSPACE_ID=

# --- 03 account scoring -------------------------------------------------------
# DiscoLike: https://discolike.com -> Account -> API keys
DISCOLIKE_API_KEY=

# --- 04 people + 05 email waterfalls -------------------------------------------
# Clay uses its own CLI login (`clay login`), no key here. See 04-people-waterfall/SKILL.md
# QuickEnrich: https://app.quickenrich.io/docs (API key in your account)
QUICKENRICH_API_KEY=
# BlitzAPI: https://app.blitz-api.ai (dashboard -> API key)
BLITZ_API_KEY=
# GetLeads: https://app.getleads.io/api-keys
GETLEADS_API_KEY=
# Prospeo: https://prospeo.io/api-docs (API key in your dashboard)
PROSPEO_API_KEY=

# --- 06 email verification -----------------------------------------------------
# MillionVerifier: https://app.millionverifier.com/api
MILLIONVERIFIER_API_KEY=
# BounceBan: https://bounceban.com/app/api/settings
BOUNCEBAN_API_KEY=

# --- 10 speed to lead ------------------------------------------------------------
# Slack bot token (xoxb-...): https://api.slack.com/apps -> your app -> OAuth & Permissions. Scope: chat:write
SLACK_BOT_TOKEN=
# Optional Slack channel ID used when a rep has no Slack user ID
SLACK_FALLBACK_CHANNEL=
# Clay: table -> add source -> Webhook -> copy the URL
CLAY_WEBHOOK_URL=
# Optional: only if you turned on auth for the Clay webhook
CLAY_WEBHOOK_AUTH_TOKEN=
# Make these two up: python -c "import secrets;print(secrets.token_hex(32))"
PLUSVIBE_WEBHOOK_SECRET=
RELAY_SHARED_SECRET=
# Public HTTPS URL where relay.py runs, e.g. https://relay.yourdomain.example
RELAY_PUBLIC_URL=
# 1 = log only, never call Clay, PlusVibe or Slack
RELAY_DRY_RUN=1
